{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuspatlas.invalid/schemas/agents/v1",
  "title": "Agents, actions and AI contract v1 (workstream A batch 2: A8-A13; synthetic only; remote MCP, model providers and prescribing partners blocked on A-S1/A-S2 and the prescribing qualification)",
  "$defs": {
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Cursor": {
      "type": "string",
      "description": "Opaque, tenant-bound, HMAC-protected. Never parse it.",
      "pattern": "^[A-Za-z0-9_-]{1,200}\\.[A-Za-z0-9_-]{22}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "ReasonCode": {
      "type": "string",
      "pattern": "^[a-z_]{1,64}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ScopeName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z]*\\.[a-z][a-zA-Z]*$",
      "maxLength": 64
    },
    "OperationName": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z]{0,40}(\\.[a-z][A-Za-z]{0,40}){0,3}$",
      "maxLength": 128
    },
    "AgentRef": {
      "$ref": "#/$defs/Uuid",
      "description": "Opaque agent principal reference (tenant from context)."
    },
    "PrincipalRef": {
      "$ref": "#/$defs/Uuid",
      "description": "Opaque principal reference."
    },
    "CredentialRef": {
      "type": "string",
      "pattern": "^agc-[0-9a-f]{32}$",
      "description": "The agent credential reference: the `sid` an agent token must carry. Rotation replaces it; a token naming an earlier one is unauthenticated."
    },
    "Purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "AgentCreate": {
      "type": "object",
      "additionalProperties": false,
      "description": "A8: a new agent principal. The sponsor is the calling human; the scope set may not include a human-only scope or a scope the sponsor lacks; the expiry is required and bounded (A-D9 open).",
      "required": ["purpose", "scopes", "expiresAt"],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/Purpose"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ScopeName"
          }
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "AgentTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRef", "expectedVersion"],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        }
      }
    },
    "AgentSponsorChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRef", "sponsorRef", "expectedVersion"],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "sponsorRef": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "AgentQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRef"],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        }
      }
    },
    "AgentListQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "state": {
          "enum": ["active", "suspended", "revoked"]
        }
      }
    },
    "AgentAuditQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRef"],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        }
      }
    },
    "AgentCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRef", "state", "expiresAt"],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "state": {
          "enum": ["active", "suspended", "revoked"]
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        },
        "credentialRef": {
          "$ref": "#/$defs/CredentialRef"
        },
        "sponsorRef": {
          "$ref": "#/$defs/PrincipalRef"
        }
      }
    },
    "AgentCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "A8 lifecycle result. The credential reference appears only on create and rotate.",
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "$ref": "#/$defs/AgentCommand"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "$ref": "#/$defs/Uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "Agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentRef",
        "purpose",
        "scopes",
        "state",
        "expiresAt",
        "sponsorRef",
        "createdBy",
        "createdAt",
        "revokedAt",
        "version",
        "grants"
      ],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "purpose": {
          "$ref": "#/$defs/Purpose"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScopeName"
          }
        },
        "state": {
          "enum": ["active", "suspended", "revoked"]
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        },
        "sponsorRef": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "createdBy": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "createdAt": {
          "$ref": "#/$defs/Instant"
        },
        "revokedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "description": "describeAgentGrants: the scopes the agent can exercise right now (reads only while suspended; none when not live).",
          "required": ["effectiveScopes", "live"],
          "properties": {
            "effectiveScopes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScopeName"
              }
            },
            "live": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "AgentRead": {
      "type": "object",
      "additionalProperties": false,
      "description": "A8: one agent principal with its live grants. Never carries the credential reference.",
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/Agent"
        }
      }
    },
    "AgentList": {
      "type": "object",
      "additionalProperties": false,
      "description": "A8: agent principals of the tenant (OR-01 envelope), oldest first.",
      "required": [
        "asOf",
        "appliedFilters",
        "scope",
        "limit",
        "truncated",
        "nextCursor",
        "ordering",
        "count",
        "items"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "appliedFilters": {
          "type": "object"
        },
        "scope": {
          "$ref": "#/$defs/ListScope"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "truncated": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": ["string", "null"]
        },
        "ordering": {
          "$ref": "#/$defs/ListOrdering"
        },
        "count": {
          "$ref": "#/$defs/ListCount"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Agent"
          }
        }
      }
    },
    "AgentAuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventRef",
        "agentRef",
        "sponsorRef",
        "operation",
        "resourceType",
        "resourceRef",
        "resourceVersion",
        "correlationId",
        "occurredAt"
      ],
      "properties": {
        "eventRef": {
          "$ref": "#/$defs/Uuid"
        },
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "sponsorRef": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "operation": {
          "$ref": "#/$defs/OperationName"
        },
        "resourceType": {
          "type": "string",
          "maxLength": 64
        },
        "resourceRef": {
          "$ref": "#/$defs/Uuid"
        },
        "resourceVersion": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "$ref": "#/$defs/Uuid"
        },
        "occurredAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "AgentAuditList": {
      "type": "object",
      "additionalProperties": false,
      "description": "A8: the separate agent-audit stream of one agent: actor is the agent, sponsor is the sponsor of record at the time.",
      "required": [
        "asOf",
        "appliedFilters",
        "scope",
        "limit",
        "truncated",
        "nextCursor",
        "ordering",
        "count",
        "items"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "appliedFilters": {
          "type": "object"
        },
        "scope": {
          "$ref": "#/$defs/ListScope"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "truncated": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": ["string", "null"]
        },
        "ordering": {
          "$ref": "#/$defs/ListOrdering"
        },
        "count": {
          "$ref": "#/$defs/ListCount"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentAuditEvent"
          }
        }
      }
    },
    "Deployment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:._/-]{1,200}$",
      "description": "The MCP deployment (its resource identifier, the token audience) the consent applies to."
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "description": "A9 call budget. The hard ceilings (pending approval) are the schema maxima; a budget above them is refused.",
      "required": [
        "periodSeconds",
        "callsPerPeriod",
        "recordsPerPeriod",
        "phiFieldsPerPeriod",
        "recordsPerCall",
        "phiFieldsPerCall"
      ],
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "callsPerPeriod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "recordsPerPeriod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "phiFieldsPerPeriod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "recordsPerCall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "phiFieldsPerCall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "ConsentRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "A9: a named human consents that one agent may call the listed operations (MCP tools) on one deployment, within a budget, until the expiry. Operations outside the agent scope set are refused.",
      "required": ["agentRef", "deployment", "operations", "budget", "expiresAt"],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "deployment": {
          "$ref": "#/$defs/Deployment"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OperationName"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "ConsentRevoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consentRef", "expectedVersion"],
      "properties": {
        "consentRef": {
          "$ref": "#/$defs/Uuid"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "ConsentListQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        }
      }
    },
    "ConsentCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consentRef", "agentRef", "state", "expiresAt"],
      "properties": {
        "consentRef": {
          "$ref": "#/$defs/Uuid"
        },
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "state": {
          "enum": ["active", "revoked"]
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "ConsentCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "A9 consent command result.",
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "$ref": "#/$defs/ConsentCommand"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "$ref": "#/$defs/Uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "Consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consentRef",
        "agentRef",
        "deployment",
        "operations",
        "budget",
        "state",
        "grantedBy",
        "grantedAt",
        "expiresAt",
        "version"
      ],
      "properties": {
        "consentRef": {
          "$ref": "#/$defs/Uuid"
        },
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "deployment": {
          "$ref": "#/$defs/Deployment"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationName"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "state": {
          "enum": ["active", "revoked"]
        },
        "grantedBy": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "grantedAt": {
          "$ref": "#/$defs/Instant"
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "ConsentList": {
      "type": "object",
      "additionalProperties": false,
      "description": "A9: consent records (OR-01 envelope), newest first.",
      "required": [
        "asOf",
        "appliedFilters",
        "scope",
        "limit",
        "truncated",
        "nextCursor",
        "ordering",
        "count",
        "items"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "appliedFilters": {
          "type": "object"
        },
        "scope": {
          "$ref": "#/$defs/ListScope"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "truncated": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": ["string", "null"]
        },
        "ordering": {
          "$ref": "#/$defs/ListOrdering"
        },
        "count": {
          "$ref": "#/$defs/ListCount"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Consent"
          }
        }
      }
    },
    "BudgetQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRef", "deployment"],
      "properties": {
        "agentRef": {
          "$ref": "#/$defs/AgentRef"
        },
        "deployment": {
          "$ref": "#/$defs/Deployment"
        }
      }
    },
    "BudgetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consentRef", "periodStartedAt", "calls", "records", "phiFields", "budget"],
      "properties": {
        "consentRef": {
          "$ref": "#/$defs/Uuid"
        },
        "periodStartedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "phiFields": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      }
    },
    "BudgetRead": {
      "type": "object",
      "additionalProperties": false,
      "description": "A9: the live budget usage of one agent on one deployment in the current period.",
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/BudgetUsage"
        }
      }
    },
    "ElevatedOperation": {
      "enum": [
        "portal.principals.enroll",
        "communications.consents.record",
        "patients.relationships.add",
        "billing.plans.authorize"
      ]
    },
    "ActionPrepare": {
      "type": "object",
      "additionalProperties": false,
      "description": "A10: prepare a proposal for an elevated (catalog approval: proposal) operation. Binds operation, payload digest, resource versions, policy version and an expiry.",
      "required": ["operation", "payload"],
      "properties": {
        "operation": {
          "$ref": "#/$defs/ElevatedOperation"
        },
        "payload": {
          "type": "object",
          "description": "The owning operation's request body, validated by its owner at commit. A bounded keyed map (A-S6): field names are the owning body's camelCase names.",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "maxProperties": 64,
          "additionalProperties": {}
        }
      }
    },
    "ActionApprove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef", "payloadDigest", "expectedVersion"],
      "properties": {
        "proposalRef": {
          "$ref": "#/$defs/Uuid"
        },
        "payloadDigest": {
          "$ref": "#/$defs/Digest"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "ActionCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef", "payloadDigest"],
      "properties": {
        "proposalRef": {
          "$ref": "#/$defs/Uuid"
        },
        "payloadDigest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "ActionAbandon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef", "expectedVersion", "reason"],
      "properties": {
        "proposalRef": {
          "$ref": "#/$defs/Uuid"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        }
      }
    },
    "ActionQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalRef"],
      "properties": {
        "proposalRef": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "ActionListQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "state": {
          "enum": ["prepared", "approved", "committed", "rejected", "expired", "abandoned"]
        }
      }
    },
    "ActionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalRef",
        "operation",
        "state",
        "payloadDigest",
        "policyVersion",
        "expiresAt",
        "proposerRef",
        "proposerKind",
        "sponsorRef",
        "approverRef",
        "resourceVersions",
        "result",
        "dispositionReason",
        "version"
      ],
      "properties": {
        "proposalRef": {
          "$ref": "#/$defs/Uuid"
        },
        "operation": {
          "$ref": "#/$defs/ElevatedOperation"
        },
        "state": {
          "enum": ["prepared", "approved", "committed", "rejected", "expired", "abandoned"]
        },
        "payloadDigest": {
          "$ref": "#/$defs/Digest"
        },
        "policyVersion": {
          "type": "string",
          "maxLength": 64
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        },
        "proposerRef": {
          "$ref": "#/$defs/PrincipalRef"
        },
        "proposerKind": {
          "enum": ["human", "service"]
        },
        "sponsorRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "approverRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref", "version"],
            "properties": {
              "kind": {
                "type": "string",
                "maxLength": 64
              },
              "ref": {
                "$ref": "#/$defs/Uuid"
              },
              "version": {
