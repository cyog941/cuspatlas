{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuspatlas.invalid/schemas/clinical/v1",
  "title": "Clinical record contract v1 (C5 encounters and authorship, C8 medical history; synthetic data only; recommended-pending-clinical-approval)",
  "$defs": {
    "ActiveAlerts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patientRef",
            "computedAt",
            "allergy",
            "condition",
            "medication",
            "interactionChecking",
            "decisionSupport"
          ],
          "properties": {
            "patientRef": {
              "$ref": "#/$defs/PatientRef"
            },
            "computedAt": {
              "$ref": "#/$defs/Instant"
            },
            "allergy": {
              "$ref": "#/$defs/AlertSection"
            },
            "condition": {
              "$ref": "#/$defs/AlertSection"
            },
            "medication": {
              "$ref": "#/$defs/AlertSection"
            },
            "interactionChecking": {
              "$ref": "#/$defs/NotProvided"
            },
            "decisionSupport": {
              "$ref": "#/$defs/NotProvided"
            }
          }
        }
      }
    },
    "ActorRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque principal reference of a tenant member."
    },
    "AlertSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items", "noneKnown", "lastReview"],
      "properties": {
        "status": {
          "$ref": "#/$defs/AlertStatus"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemRef",
              "displayText",
              "codeRef",
              "detailText",
              "provenance",
              "verified",
              "recordedAt"
            ],
            "properties": {
              "itemRef": {
                "$ref": "#/$defs/HistoryItemRef"
              },
              "displayText": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/HistoryText"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "codeRef": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SyntheticCodeRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detailText": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/HistoryDetailText"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provenance": {
                "$ref": "#/$defs/HistoryProvenance"
              },
              "verified": {
                "type": "boolean"
              },
              "recordedAt": {
                "$ref": "#/$defs/Instant"
              }
            }
          }
        },
        "noneKnown": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemRef", "provenance", "recordedAt"],
              "properties": {
                "itemRef": {
                  "$ref": "#/$defs/HistoryItemRef"
                },
                "provenance": {
                  "$ref": "#/$defs/HistoryProvenance"
                },
                "recordedAt": {
                  "$ref": "#/$defs/Instant"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "lastReview": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reviewRef", "encounterRef", "outcome", "reviewedBy", "reviewedAt", "stale"],
              "properties": {
                "reviewRef": {
                  "$ref": "#/$defs/HistoryReviewRef"
                },
                "encounterRef": {
                  "$ref": "#/$defs/EncounterRef"
                },
                "outcome": {
                  "$ref": "#/$defs/ReviewOutcome"
                },
                "reviewedBy": {
                  "$ref": "#/$defs/ClinicalAuthor"
                },
                "reviewedAt": {
                  "$ref": "#/$defs/Instant"
                },
                "stale": {
                  "type": "boolean",
                  "description": "True when an item of this kind was recorded after the review."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AlertStatus": {
      "enum": ["unknown", "none_reported", "reviewed_none", "present"],
      "description": "unknown: nothing recorded or reviewed (never \"no allergies\"); none_reported: a none-known statement is recorded; reviewed_none: a clinician attested none at an encounter and nothing of the kind was recorded since; present: active items exist."
    },
    "AppointmentRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque appointment (booking) reference (S10)."
    },
    "AppointmentStatus": {
      "enum": ["booked", "cancelled", "rescheduled"]
    },
    "Assignee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceRef"],
      "description": "A scheduling resource of kind provider (provider roles) or staff (the staff role) at the encounter location.",
      "properties": {
        "kind": {
          "enum": ["provider", "staff"]
        },
        "resourceRef": {
          "$ref": "#/$defs/ResourceRefId"
        }
      }
    },
    "AssignmentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "assignee"],
      "properties": {
        "role": {
          "$ref": "#/$defs/AssignmentRole"
        },
        "assignee": {
          "$ref": "#/$defs/Assignee"
        }
      }
    },
    "AssignmentRole": {
      "enum": [
        "treating_provider",
        "secondary_provider",
        "supervising_provider",
        "staff",
        "completing_provider"
      ],
      "description": "Encounter role assignments, each independent of the others and of the author."
    },
    "AuthorContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolvable", "author", "reason"],
          "properties": {
            "resolvable": {
              "type": "boolean"
            },
            "author": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClinicalAuthor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "enum": ["service_principal", "no_profile", "profile_inactive"]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "ClinicalAuthor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorRef", "role", "credentialRef"],
      "description": "Who authored a clinical mutation: the authenticated human and the clinical role configured for them at that instant.",
      "properties": {
        "actorRef": {
          "$ref": "#/$defs/ActorRef"
        },
        "role": {
          "$ref": "#/$defs/ClinicalRole"
        },
        "credentialRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ClinicalAuthorCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "$ref": "#/$defs/ClinicalAuthorProfile"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "ClinicalAuthorDefine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorRef", "role"],
      "description": "Define (no expectedVersion) or change (with expectedVersion) the clinical author profile of a tenant member. Requires admin.configure.",
      "properties": {
        "actorRef": {
          "$ref": "#/$defs/ActorRef"
        },
        "role": {
          "$ref": "#/$defs/ClinicalRole"
        },
        "credentialRef": {
          "$ref": "#/$defs/CredentialRef"
        },
        "active": {
          "type": "boolean"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "ClinicalAuthorProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorRef", "role", "credentialRef", "active", "version"],
      "properties": {
        "actorRef": {
          "$ref": "#/$defs/ActorRef"
        },
        "role": {
          "$ref": "#/$defs/ClinicalRole"
        },
        "credentialRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "ClinicalRole": {
      "enum": ["dentist", "hygienist", "assistant", "other_clinical"],
      "description": "Configured clinical role of an author (recommended-pending-clinical-approval)."
    },
    "CredentialRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "Reference to a credential held by the staff module; the credential detail is not stored here."
    },
    "Cursor": {
      "type": "string",
      "description": "Opaque, tenant-bound, HMAC-protected. Never parse it.",
      "pattern": "^[A-Za-z0-9_-]{1,200}\\.[A-Za-z0-9_-]{22}$"
    },
    "DispositionCode": {
      "type": "string",
      "pattern": "^[a-z_]{1,64}$",
      "description": "Tenant-configured encounter disposition code."
    },
    "Encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encounterRef",
        "patientRef",
        "locationRef",
        "appointment",
        "flags",
        "state",
        "assignments",
        "assignmentHistory",
        "openedBy",
        "openedAt",
        "closure",
        "version"
      ],
      "description": "Encounter (C5). Attendance (S11), procedure completion (C14) and billing (B1) are separate facts and never set here.",
      "properties": {
        "encounterRef": {
          "$ref": "#/$defs/EncounterRef"
        },
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        },
        "appointment": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["appointmentRef", "statusAtOpen", "currentStatus", "rescheduledToRef"],
              "properties": {
                "appointmentRef": {
                  "$ref": "#/$defs/AppointmentRef"
                },
                "statusAtOpen": {
                  "$ref": "#/$defs/AppointmentStatus"
                },
                "currentStatus": {
                  "$ref": "#/$defs/AppointmentStatus"
                },
                "rescheduledToRef": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/AppointmentRef"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/EncounterFlag"
          }
        },
        "state": {
          "enum": ["open", "closed"]
        },
        "assignments": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/EncounterAssignment"
          }
        },
        "assignmentHistory": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/EncounterAssignment"
          }
        },
        "openedBy": {
          "$ref": "#/$defs/ClinicalAuthor"
        },
        "openedAt": {
          "$ref": "#/$defs/Instant"
        },
        "closure": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["dispositionCode", "closedBy", "closedAt"],
              "properties": {
                "dispositionCode": {
                  "$ref": "#/$defs/DispositionCode"
                },
                "closedBy": {
                  "$ref": "#/$defs/ClinicalAuthor"
                },
                "closedAt": {
                  "$ref": "#/$defs/Instant"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "EncounterAssign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "role", "assignee"],
      "properties": {
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "role": {
          "$ref": "#/$defs/AssignmentRole"
        },
        "assignee": {
          "anyOf": [
            {
              "$ref": "#/$defs/Assignee"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "EncounterAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "role", "assignee", "assignedBy", "assignedAt"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "#/$defs/AssignmentRole"
        },
        "assignee": {
          "anyOf": [
            {
              "$ref": "#/$defs/Assignee"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignedBy": {
          "$ref": "#/$defs/ClinicalAuthor"
        },
        "assignedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "EncounterClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "dispositionCode"],
      "properties": {
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "dispositionCode": {
          "$ref": "#/$defs/DispositionCode"
        }
      }
    },
    "EncounterCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "$ref": "#/$defs/Encounter"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "EncounterFlag": {
      "enum": [
        "appointment_cancelled_at_open",
        "appointment_rescheduled_at_open",
        "appointment_changed_since_open"
      ]
    },
    "EncounterList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor"],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Encounter"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "EncounterListQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|100)$"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        }
      }
    },
    "EncounterOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patientRef"],
      "description": "Open an encounter. With an appointment the location is the appointment location; without one, locationRef is required.",
      "properties": {
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "appointmentRef": {
          "$ref": "#/$defs/AppointmentRef"
        },
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        },
        "assignments": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/AssignmentInput"
          }
        }
      }
    },
    "EncounterOpenResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "encounter"],
          "properties": {
            "outcome": {
              "enum": ["opened", "existing"]
            },
            "encounter": {
              "$ref": "#/$defs/Encounter"
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "EncounterRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/Encounter"
        }
      }
    },
    "EncounterRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque encounter reference (C5)."
    },
    "HistoryChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeRef",
        "itemSequence",
        "state",
        "displayText",
        "codeRef",
        "detailText",
        "effectiveFrom",
        "effectiveUntil",
        "reasonCode",
        "recorded"
      ],
      "properties": {
        "changeRef": {
          "$ref": "#/$defs/HistoryChangeRef"
        },
        "itemSequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/HistoryState"
        },
        "displayText": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryText"
            },
            {
              "type": "null"
            }
          ]
        },
        "codeRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/SyntheticCodeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "detailText": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryDetailText"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveUntil": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded": {
          "$ref": "#/$defs/HistoryVersionHeader"
        }
      }
    },
    "HistoryChangeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "description": "A new item (kind, no itemRef) or a change of an existing item (itemRef, no kind). Unspecified text and dates carry forward.",
      "properties": {
        "itemRef": {
          "$ref": "#/$defs/HistoryItemRef"
        },
        "kind": {
          "$ref": "#/$defs/HistoryKind"
        },
        "entryType": {
          "$ref": "#/$defs/HistoryEntryType"
        },
        "state": {
          "$ref": "#/$defs/HistoryState"
        },
        "displayText": {
          "$ref": "#/$defs/HistoryText"
        },
        "codeRef": {
          "$ref": "#/$defs/SyntheticCodeRef"
        },
        "detailText": {
          "$ref": "#/$defs/HistoryDetailText"
        },
        "effectiveFrom": {
          "$ref": "#/$defs/LocalDate"
        },
        "effectiveUntil": {
          "$ref": "#/$defs/LocalDate"
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCode"
        }
      }
    },
    "HistoryChangeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patientRef", "provenance", "reportedBy", "changes"],
      "description": "Record one history version (an append-only change set). Verification is a separate command and cannot be set here.",
      "properties": {
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "encounterRef": {
          "$ref": "#/$defs/EncounterRef"
        },
        "provenance": {
          "$ref": "#/$defs/HistoryProvenance"
        },
        "reportedBy": {
          "$ref": "#/$defs/ReportedBy"
        },
        "sourceRef": {
          "$ref": "#/$defs/SourceRef"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/HistoryChangeInput"
          }
        }
      }
    },
    "HistoryChangeRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque history change reference (C8)."
    },
    "HistoryDetailText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Free-text detail (reaction, dose, notes) as reported."
    },
    "HistoryEntryType": {
      "enum": ["fact", "none_known"],
      "description": "none_known records an explicit \"none known\" statement for allergy, condition or medication; it is not the same as nothing recorded."
    },
    "HistoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemRef",
        "kind",
        "entryType",
        "streamRef",
        "sourcePatientRef",
        "current",
        "verification",
        "changes",
        "verifications"
      ],
      "description": "An item as of the read instant: its current change, the verification of that exact change (or null), and every earlier change and verification.",
      "properties": {
        "itemRef": {
          "$ref": "#/$defs/HistoryItemRef"
        },
        "kind": {
          "$ref": "#/$defs/HistoryKind"
        },
        "entryType": {
          "$ref": "#/$defs/HistoryEntryType"
        },
        "streamRef": {
          "$ref": "#/$defs/HistoryStreamRef"
        },
        "sourcePatientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "current": {
          "$ref": "#/$defs/HistoryChange"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryVerification"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/HistoryChange"
          }
        },
        "verifications": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/HistoryVerification"
          }
        }
      }
    },
    "HistoryItemCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "$ref": "#/$defs/HistoryItem"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "HistoryItemRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque history item reference (C8)."
    },
    "HistoryKind": {
      "enum": ["condition", "allergy", "medication", "vital", "social"]
    },
    "HistoryProvenance": {
      "enum": ["staff", "patient_reported", "imported"]
    },
    "HistoryRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patientRef", "asOf", "recorded", "streams", "items"],
          "properties": {
            "patientRef": {
              "$ref": "#/$defs/PatientRef"
            },
            "asOf": {
              "$ref": "#/$defs/Instant"
            },
            "recorded": {
              "type": "boolean",
              "description": "False when nothing was recorded as of the instant: an unknown history, not an empty one."
            },
            "streams": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/HistoryStream"
              }
            },
            "items": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "$ref": "#/$defs/HistoryItem"
              }
            }
          }
        }
      }
    },
    "HistoryReadQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "asOf": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "HistoryReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewRef",
        "encounterRef",
        "patientRef",
        "allergy",
        "condition",
        "medication",
        "reviewedBy",
        "reviewedAt"
      ],
      "properties": {
        "reviewRef": {
          "$ref": "#/$defs/HistoryReviewRef"
        },
        "encounterRef": {
          "$ref": "#/$defs/EncounterRef"
        },
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "allergy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "medication": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedBy": {
          "$ref": "#/$defs/ClinicalAuthor"
        },
        "reviewedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "HistoryReviewAttest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "allergy": {
          "$ref": "#/$defs/ReviewOutcome"
        },
        "condition": {
          "$ref": "#/$defs/ReviewOutcome"
        },
        "medication": {
          "$ref": "#/$defs/ReviewOutcome"
        }
      }
    },
    "HistoryReviewCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "$ref": "#/$defs/HistoryReview"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "HistoryReviewRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque history review attestation reference (C8)."
    },
    "HistoryState": {
      "enum": ["active", "resolved", "discontinued", "entered_in_error"],
      "description": "Removal is a state change with a reason, never a delete. discontinued applies to medications only."
    },
    "HistoryStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streamRef", "sourcePatientRef", "version"],
      "properties": {
        "streamRef": {
          "$ref": "#/$defs/HistoryStreamRef"
        },
        "sourcePatientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "HistoryStreamRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque history stream reference: one per source patient (C8)."
    },
    "HistoryText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Free text as reported; never interpreted, never checked against a drug database."
    },
    "HistoryVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeRef", "verifiedBy", "verifiedAt", "encounterRef"],
      "properties": {
        "changeRef": {
          "$ref": "#/$defs/HistoryChangeRef"
        },
        "verifiedBy": {
          "$ref": "#/$defs/ClinicalAuthor"
        },
        "verifiedAt": {
          "$ref": "#/$defs/Instant"
        },
        "encounterRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncounterRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HistoryVerify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedChangeRef"],
      "properties": {
        "expectedChangeRef": {
          "$ref": "#/$defs/HistoryChangeRef"
        },
        "encounterRef": {
          "$ref": "#/$defs/EncounterRef"
        }
      }
    },
    "HistoryVersionCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "$ref": "#/$defs/HistoryVersionDetail"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "HistoryVersionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "changes"],
      "properties": {
        "header": {
          "$ref": "#/$defs/HistoryVersionHeader"
        },
        "changes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["itemRef", "kind", "entryType", "change"],
            "properties": {
              "itemRef": {
                "$ref": "#/$defs/HistoryItemRef"
              },
              "kind": {
                "$ref": "#/$defs/HistoryKind"
              },
              "entryType": {
                "$ref": "#/$defs/HistoryEntryType"
              },
              "change": {
                "$ref": "#/$defs/HistoryChange"
              }
            }
          }
        }
      }
    },
    "HistoryVersionHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historyVersionRef",
        "streamRef",
        "version",
        "provenance",
        "reportedBy",
        "sourceRef",
        "encounterRef",
        "recordedBy",
        "recordedAt"
      ],
      "description": "One recorded history version: who reported it, who recorded it, from which source, when.",
      "properties": {
        "historyVersionRef": {
          "$ref": "#/$defs/HistoryVersionRef"
        },
        "streamRef": {
          "$ref": "#/$defs/HistoryStreamRef"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "provenance": {
          "$ref": "#/$defs/HistoryProvenance"
        },
        "reportedBy": {
          "$ref": "#/$defs/ReportedBy"
        },
        "sourceRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "encounterRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncounterRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedBy": {
          "$ref": "#/$defs/ClinicalAuthor"
        },
        "recordedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "HistoryVersionRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/HistoryVersionDetail"
        }
      }
    },
    "HistoryVersionRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque history version reference (C8)."
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "description": "RFC 3339 instant, returned in UTC."
    },
    "LocalDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "LocationRef": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "NotProvided": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "statement"],
      "properties": {
        "provided": {
          "const": false
        },
        "statement": {
          "type": "string"
        }
      }
    },
    "PatientRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque patient reference (S4)."
    },
    "ReasonCode": {
      "type": "string",
      "pattern": "^[a-z_]{1,64}$",
      "description": "Server-checked reason value; never free text (vocabulary pending clinical approval)."
    },
    "ReportedBy": {
      "enum": ["patient", "guardian", "caregiver", "clinician", "external_record"],
      "description": "Who reported the information (the recorder is always the authenticated clinical author)."
    },
    "ResourceRefId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque scheduling resource reference (S7)."
    },
    "ReviewOutcome": {
      "enum": ["none", "confirmed"],
      "description": "none: reviewed with the patient and none present; confirmed: the recorded list was reviewed."
    },
    "SourceRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "Reference to the source document or import batch; required for imported provenance."
    },
    "SyntheticCodeRef": {
      "type": "string",
      "pattern": "^SYN-[A-Z0-9-]{1,40}$",
      "description": "Provisional internal synthetic code (C-D2). Not a licensed terminology code; carries no clinical meaning."
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
