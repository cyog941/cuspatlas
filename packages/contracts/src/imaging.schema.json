{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuspatlas.invalid/schemas/imaging/v1",
  "title": "Imaging contract v1 (I1-I4, I8; synthetic data only, no device or DICOM qualified)",
  "$defs": {
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "EntityRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ObjectRef": {
      "$ref": "#/$defs/EntityRef",
      "description": "Opaque image object reference (an original or a derived object). Never a storage path."
    },
    "GrantRef": {
      "$ref": "#/$defs/EntityRef",
      "description": "Opaque reference of a short-lived read grant."
    },
    "PatientRef": {
      "$ref": "#/$defs/EntityRef",
      "description": "Opaque patient reference owned by workstream S."
    },
    "Instant": {
      "type": "string",
      "description": "RFC 3339 instant with an explicit offset; stored and returned in UTC.",
      "format": "date-time",
      "maxLength": 40
    },
    "ReasonCode": {
      "type": "string",
      "pattern": "^[a-z_]{1,64}$",
      "description": "Server-checked reason enumeration value; never free text."
    },
    "TimeZone": {
      "type": "string",
      "description": "IANA time zone name. The server also requires its zone database to know it.",
      "maxLength": 64,
      "pattern": "^(UTC|[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){1,2})$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hex SHA-256 of the exact object bytes."
    },
    "ContentType": {
      "enum": ["image/png", "image/jpeg", "image/tiff", "application/pdf", "application/dicom"],
      "description": "Accepted media types. The server sniffs magic bytes and never trusts a declared type or file extension. application/dicom is stored opaquely (I5 deferred; no parsing)."
    },
    "ObjectState": {
      "enum": ["available", "quarantined", "deleted"],
      "description": "available: verified and servable; quarantined: retained for investigation, never served; deleted: tombstone, bytes removed."
    },
    "ObjectKind": {
      "enum": ["original", "derived"]
    },
    "ProvenanceSource": {
      "enum": ["operatorUpload", "bridgeImport", "migrationArchive"]
    },
    "OriginalFilename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$",
      "description": "Display name supplied by the uploader. Never used as a storage path; separators, control characters and dot-only names are refused."
    },
    "DeviceRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
      "description": "Placeholder device identifier (no device is qualified; I-S1)."
    },
    "CaptureSoftware": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
      "description": "Placeholder acquisition-software code (no acquisition software is qualified; I-S1)."
    },
    "ProvenanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "description": "Recorded once per ingress and never rewritten. The uploader is the authenticated actor, never a body field.",
      "properties": {
        "source": {
          "$ref": "#/$defs/ProvenanceSource"
        },
        "deviceRef": {
          "$ref": "#/$defs/DeviceRef"
        },
        "captureSoftware": {
          "$ref": "#/$defs/CaptureSoftware"
        },
        "originalFilename": {
          "$ref": "#/$defs/OriginalFilename"
        },
        "acquiredAt": {
          "$ref": "#/$defs/Instant"
        },
        "acquiredTimeZone": {
          "$ref": "#/$defs/TimeZone"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenanceRef",
        "source",
        "operatorRef",
        "deviceRef",
        "captureSoftware",
        "originalFilename",
        "acquiredAt",
        "acquiredTimeZone",
        "ingressRef",
        "recordedAt"
      ],
      "properties": {
        "provenanceRef": {
          "$ref": "#/$defs/EntityRef"
        },
        "source": {
          "$ref": "#/$defs/ProvenanceSource"
        },
        "operatorRef": {
          "$ref": "#/$defs/EntityRef"
        },
        "deviceRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "captureSoftware": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureSoftware"
            },
            {
              "type": "null"
            }
          ]
        },
        "originalFilename": {
          "anyOf": [
            {
              "$ref": "#/$defs/OriginalFilename"
            },
            {
              "type": "null"
            }
          ]
        },
        "acquiredAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "acquiredTimeZone": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeZone"
            },
            {
              "type": "null"
            }
          ]
        },
        "ingressRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "ImageObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectRef",
        "kind",
        "state",
        "contentType",
        "byteLength",
        "digestSha256",
        "receivedAt",
        "quarantineReason",
        "version",
        "provenance"
      ],
      "description": "Object metadata. The storage key is internal and never returned; bytes are read only through a short-lived read grant on REST.",
      "properties": {
        "objectRef": {
          "$ref": "#/$defs/ObjectRef"
        },
        "kind": {
          "$ref": "#/$defs/ObjectKind"
        },
        "state": {
          "$ref": "#/$defs/ObjectState"
        },
        "contentType": {
          "$ref": "#/$defs/ContentType"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "digestSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "receivedAt": {
          "$ref": "#/$defs/Instant"
        },
        "quarantineReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "provenance": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Provenance"
          }
        }
      }
    },
    "ImageObjectRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/ImageObject"
        }
      }
    },
    "ObjectListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/ObjectState"
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|100)$"
        }
      }
    },
    "ImageObjectList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ImageObject"
          }
        }
      }
    },
    "ReadGrantRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "Grant lifetime; default 60 s, at most 300 s."
        }
      }
    },
    "ReadGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantRef", "objectRef", "token", "expiresAt", "contentPath"],
      "properties": {
        "grantRef": {
          "$ref": "#/$defs/GrantRef"
        },
        "objectRef": {
          "$ref": "#/$defs/ObjectRef"
        },
        "token": {
          "type": "string",
          "pattern": "^v1\\.[0-9a-f-]{36}\\.[0-9]{10}\\.[A-Za-z0-9_-]{43}$",
          "description": "HMAC token bound to tenant, principal, object, grant and expiry. Sent in the x-object-read-token header with the caller's own bearer token; useless to any other principal. Never logged."
        },
        "expiresAt": {
          "$ref": "#/$defs/Instant"
        },
        "contentPath": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "ReadGrantResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/ReadGrant"
        }
      }
    },
    "ReadGrantRevoke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ReadGrantCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grantRef", "objectRef", "state"],
          "properties": {
            "grantRef": {
              "$ref": "#/$defs/GrantRef"
            },
            "objectRef": {
              "$ref": "#/$defs/ObjectRef"
            },
            "state": {
              "enum": ["revoked"]
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "ObjectBytes": {
      "type": "string",
      "description": "Raw object bytes (application/octet-stream on the wire). REST only; MCP never carries bytes."
    },
    "StorageReconcile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "StorageReconcileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked", "quarantined", "tombstoned", "abandonedIngress", "bytesRemoved", "more"],
          "properties": {
            "checked": {
              "type": "integer",
              "minimum": 0
            },
            "quarantined": {
              "type": "integer",
              "minimum": 0
            },
            "tombstoned": {
              "type": "integer",
              "minimum": 0
            },
            "abandonedIngress": {
              "type": "integer",
              "minimum": 0
            },
            "bytesRemoved": {
              "type": "integer",
              "minimum": 0
            },
            "more": {
              "type": "boolean"
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "IngressRef": {
      "$ref": "#/$defs/EntityRef",
      "description": "Opaque ingress session reference (staging; never an object)."
    },
    "ScanVerdict": {
      "enum": ["clean", "infected", "unknown"],
      "description": "Malware gate verdict. unknown is never clean."
    },
    "IngressState": {
      "enum": ["awaiting_bytes", "staged", "accepted", "quarantined", "abandoned"]
    },
    "IngressBegin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentType", "byteLength", "declaredDigest", "provenance"],
      "properties": {
        "contentType": {
          "$ref": "#/$defs/ContentType"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "declaredDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceInput"
        },
        "intendedPatientRef": {
          "$ref": "#/$defs/PatientRef",
          "description": "Patient the uploader names (scopes dedupe and becomes a match candidate); never an association by itself."
        }
      },
      "description": "Begin an ingress: declare the media type, exact length and SHA-256; the server checks them all again against the bytes."
    },
    "IngressBeginResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ingressRef", "state", "maxBytes", "expiresAt"],
          "properties": {
            "ingressRef": {
              "$ref": "#/$defs/IngressRef"
            },
            "state": {
              "const": "awaiting_bytes"
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "expiresAt": {
              "$ref": "#/$defs/Instant"
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "IngressUploadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ingressRef", "state", "observedDigest", "byteLength"],
          "properties": {
            "ingressRef": {
              "$ref": "#/$defs/IngressRef"
            },
            "state": {
              "const": "staged"
            },
            "observedDigest": {
              "$ref": "#/$defs/Sha256"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "IngressComplete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedDigest"],
      "properties": {
        "observedDigest": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "IngressCompleteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ingressRef", "objectRef", "state", "deduplicated", "provenanceRef"],
          "properties": {
            "ingressRef": {
              "$ref": "#/$defs/IngressRef"
            },
            "objectRef": {
              "$ref": "#/$defs/ObjectRef"
            },
            "state": {
              "const": "available"
            },
            "deduplicated": {
              "type": "boolean"
            },
            "provenanceRef": {
              "$ref": "#/$defs/EntityRef"
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "IngressData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingressRef",
        "state",
        "declaredContentType",
        "declaredByteLength",
        "declaredDigest",
        "observedDigest",
        "observedByteLength",
        "scan",
        "quarantineReason",
        "objectRef",
        "createdAt",
        "version"
      ],
      "properties": {
        "ingressRef": {
          "$ref": "#/$defs/IngressRef"
        },
        "state": {
          "$ref": "#/$defs/IngressState"
        },
        "declaredContentType": {
          "$ref": "#/$defs/ContentType"
        },
        "declaredByteLength": {
          "type": "integer",
          "minimum": 1
        },
        "declaredDigest": {
          "$ref": "#/$defs/Sha256"
        },
        "observedDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedByteLength": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScanVerdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "quarantineReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "objectRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Instant"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "IngressRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/IngressData"
        }
      }
    },
    "ImagingWorkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemRef",
        "kind",
        "reasonCode",
        "explanation",
        "evidenceRefs",
        "owner",
        "nextActionOwedBy",
        "dueAt",
        "priority",
        "priorityRationale",
        "suggestedNextAction",
        "blockingDependencies"
      ],
      "properties": {
        "workItemRef": {
          "$ref": "#/$defs/EntityRef"
        },
        "kind": {
          "enum": ["ingress_quarantined", "ingress_scan_pending", "ingress_incomplete", "image_unmatched"]
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCode"
        },
        "explanation": {
          "type": "string",
          "maxLength": 300,
          "description": "Server-authored; never caller text."
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z]{0,63}$"
              },
              "ref": {
                "$ref": "#/$defs/EntityRef"
              }
            }
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queue", "principalRef"],
          "properties": {
            "queue": {
              "$ref": "#/$defs/ReasonCode"
            },
            "principalRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EntityRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "nextActionOwedBy": {
          "enum": ["practice", "patient", "payer", "vendor", "platform"]
        },
        "dueAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "enum": ["routine", "elevated", "urgent"]
        },
        "priorityRationale": {
          "$ref": "#/$defs/ReasonCode"
        },
        "suggestedNextAction": {
          "$ref": "#/$defs/ReasonCode"
        },
        "blockingDependencies": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/ReasonCode"
          }
        },
        "ageHours": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Imaging work item: the same exception-first shape as the S proposed WorkItem, with imaging kinds."
    },
    "ImagingWorkItemList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asOf", "coverage", "count", "items"],
          "properties": {
            "asOf": {
              "$ref": "#/$defs/Instant"
            },
            "coverage": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "const": "available"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "reason", "owner"],
                  "properties": {
                    "status": {
                      "const": "unavailable"
                    },
                    "reason": {
                      "$ref": "#/$defs/ReasonCode"
                    },
                    "owner": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9-]{0,15}$"
                    }
                  }
                }
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/ImagingWorkItem"
              }
            }
          }
        }
      }
    },
    "IngressFailureQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    }
  }
}
