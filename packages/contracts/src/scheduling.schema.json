{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuspatlas.invalid/schemas/scheduling/v1",
  "title": "Scheduling resources and availability contract v1 (S7, S9; synthetic data only)",
  "$defs": {
    "LocationRef": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "Version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "IdempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "ResourceRefId": {
      "type": "string",
      "description": "Opaque server-issued resource identifier. Never parse it.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "EntityRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ResourceKind": { "enum": ["provider", "operatory", "equipment", "staff"] },
    "ResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceRef"],
      "properties": {
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" }
      }
    },
    "OperatoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceRef"],
      "properties": {
        "kind": { "const": "operatory" },
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" }
      }
    },
    "DisplayLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
    "DisplayOrder": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "TimeZone": {
      "type": "string",
      "description": "IANA time zone name. The server also requires its zone database to know it.",
      "maxLength": 64,
      "pattern": "^(UTC|[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){1,2})$"
    },
    "LocalDate": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "LocalTime": { "type": "string", "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$" },
    "Instant": {
      "type": "string",
      "description": "RFC 3339 instant with an explicit offset; stored and returned in UTC.",
      "format": "date-time",
      "maxLength": 40
    },
    "ResourceStatus": { "enum": ["active", "inactive"] },
    "TimeBlockReason": {
      "description": "Proposed reason vocabulary for unavailable time (not a practice decision).",
      "enum": ["meeting", "maintenance", "training", "holiday", "lunch", "personal", "other"]
    },
    "NoOperatoryReason": {
      "description": "Reserved exception vocabulary for an appointment that holds no operatory (S7). Proposed; starts with the observed no-show and cancellation cases. Never modelled as a resource.",
      "enum": ["no_show", "cancelled", "not_yet_assigned", "off_site"]
    },
    "AppointmentOperatoryAssignment": {
      "description": "Booking-side shape (consumed by S10): an appointment holds zero or one operatory; holding none requires a typed reason.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatory"],
          "properties": { "operatory": { "$ref": "#/$defs/OperatoryRef" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatory", "noOperatoryReason"],
          "properties": {
            "operatory": { "type": "null" },
            "noOperatoryReason": { "$ref": "#/$defs/NoOperatoryReason" }
          }
        }
      ]
    },
    "WeeklyInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday", "start", "end"],
      "properties": {
        "weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO weekday, 1 = Monday"
        },
        "start": { "$ref": "#/$defs/LocalTime" },
        "end": { "$ref": "#/$defs/LocalTime" }
      }
    },
    "WeeklyHours": { "type": "array", "maxItems": 28, "items": { "$ref": "#/$defs/WeeklyInterval" } },
    "LocationDefine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "displayLabel", "timeZone"],
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "$ref": "#/$defs/DisplayLabel" },
        "timeZone": { "$ref": "#/$defs/TimeZone" }
      }
    },
    "LocationTimeZoneChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeZone", "expectedVersion"],
      "properties": {
        "timeZone": { "$ref": "#/$defs/TimeZone" },
        "expectedVersion": { "$ref": "#/$defs/Version" }
      }
    },
    "ResourceDefine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locationRef"],
      "properties": {
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "$ref": "#/$defs/DisplayLabel" },
        "displayOrder": { "$ref": "#/$defs/DisplayOrder" }
      }
    },
    "AvailabilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveFrom", "weekly"],
      "properties": {
        "effectiveFrom": { "$ref": "#/$defs/LocalDate" },
        "weekly": { "$ref": "#/$defs/WeeklyHours" }
      }
    },
    "ResourceDeactivate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion"],
      "properties": { "expectedVersion": { "$ref": "#/$defs/Version" } }
    },
    "TimeBlockCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "startsAt", "endsAt", "reasonCode", "resources"],
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "startsAt": { "$ref": "#/$defs/Instant" },
        "endsAt": { "$ref": "#/$defs/Instant" },
        "reasonCode": { "$ref": "#/$defs/TimeBlockReason" },
        "resources": {
          "type": "array",
          "maxItems": 20,
          "description": "Empty = a location-wide block.",
          "items": { "$ref": "#/$defs/ResourceRef" }
        }
      }
    },
    "ResourceListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "limit": { "type": "string", "pattern": "^([1-9]|[1-9][0-9]|100)$" },
        "cursor": { "$ref": "#/$defs/Cursor" }
      }
    },
    "LocationListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "string", "pattern": "^([1-9]|[1-9][0-9]|100)$" },
        "cursor": { "$ref": "#/$defs/Cursor" }
      }
    },
    "Cursor": {
      "type": "string",
      "description": "Opaque, tenant-bound, HMAC-protected. Never parse it.",
      "pattern": "^[A-Za-z0-9_-]{1,600}\\.[A-Za-z0-9_-]{22}$"
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "displayLabel", "timeZone", "status", "version"],
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "$ref": "#/$defs/DisplayLabel" },
        "timeZone": { "$ref": "#/$defs/TimeZone" },
        "status": { "$ref": "#/$defs/ResourceStatus" },
        "version": { "$ref": "#/$defs/Version" }
      }
    },
    "LocationList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor"],
      "properties": {
        "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Location" } },
        "nextCursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] }
      }
    },
    "AvailabilityVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availabilityRef", "effectiveFrom", "effectiveUntil", "timeZone", "weekly"],
      "properties": {
        "availabilityRef": { "$ref": "#/$defs/EntityRef" },
        "effectiveFrom": { "$ref": "#/$defs/LocalDate" },
        "effectiveUntil": {
          "description": "Exclusive; the next version's effectiveFrom, or null when open-ended.",
          "anyOf": [{ "$ref": "#/$defs/LocalDate" }, { "type": "null" }]
        },
        "timeZone": { "$ref": "#/$defs/TimeZone" },
        "weekly": { "$ref": "#/$defs/WeeklyHours" }
      }
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "kind", "locationRef", "displayLabel", "displayOrder", "status", "version"],
      "properties": {
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "anyOf": [{ "$ref": "#/$defs/DisplayLabel" }, { "type": "null" }] },
        "displayOrder": { "$ref": "#/$defs/DisplayOrder" },
        "status": { "$ref": "#/$defs/ResourceStatus" },
        "version": { "$ref": "#/$defs/Version" }
      }
    },
    "ResourceDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRef",
        "kind",
        "locationRef",
        "displayLabel",
        "displayOrder",
        "status",
        "version",
        "availability"
      ],
      "properties": {
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "anyOf": [{ "$ref": "#/$defs/DisplayLabel" }, { "type": "null" }] },
        "displayOrder": { "$ref": "#/$defs/DisplayOrder" },
        "status": { "$ref": "#/$defs/ResourceStatus" },
        "version": { "$ref": "#/$defs/Version" },
        "availability": { "type": "array", "items": { "$ref": "#/$defs/AvailabilityVersion" } }
      }
    },
    "ResourceRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": { "data": { "$ref": "#/$defs/ResourceDetail" } }
    },
    "ResourceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor"],
      "properties": {
        "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Resource" } },
        "nextCursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] }
      }
    },
    "StateLabelReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vocabularyVersion",
            "checkedAt",
            "resourcesChecked",
            "stateLabelledCount",
            "stateLabelled"
          ],
          "properties": {
            "vocabularyVersion": { "type": "string", "pattern": "^scheduling-state-labels\\.[0-9]+$" },
            "checkedAt": { "$ref": "#/$defs/Instant" },
            "resourcesChecked": { "type": "integer", "minimum": 0 },
            "stateLabelledCount": { "type": "integer", "minimum": 0 },
            "stateLabelled": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["resourceRef", "kind", "locationRef", "matchedTerm"],
                "properties": {
                  "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
                  "kind": { "$ref": "#/$defs/ResourceKind" },
                  "locationRef": { "$ref": "#/$defs/LocationRef" },
                  "matchedTerm": { "type": "string", "pattern": "^[a-z ]{1,40}$" }
                }
              }
            }
          }
        }
      }
    },
    "LocationCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locationRef", "timeZone"],
          "properties": {
            "locationRef": { "$ref": "#/$defs/LocationRef" },
            "timeZone": { "$ref": "#/$defs/TimeZone" }
          }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "ResourceCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceRef", "kind", "status"],
          "properties": {
            "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
            "kind": { "$ref": "#/$defs/ResourceKind" },
            "status": { "$ref": "#/$defs/ResourceStatus" }
          }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "AvailabilityCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceRef", "availabilityRef", "effectiveFrom"],
          "properties": {
            "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
            "availabilityRef": { "$ref": "#/$defs/EntityRef" },
            "effectiveFrom": { "$ref": "#/$defs/LocalDate" }
          }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "TimeBlockCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeBlockRef"],
          "properties": { "timeBlockRef": { "$ref": "#/$defs/EntityRef" } }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    }
  }
}
