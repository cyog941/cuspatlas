{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuspatlas.invalid/schemas/scheduling/v1",
  "title": "Scheduling resources, availability, requests, booking and attendance contract v1 (S7-S11; synthetic data only)",
  "$defs": {
    "AvailabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "One resource the window must occupy: a named resource, or any active resource of the kind at the location.",
      "properties": {
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" }
      }
    },
    "AvailabilitySearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "from", "to", "durationMinutes", "displayTimeZone", "requirements"],
      "description": "S9 query. Range is local dates in the location's zone, inclusive, at most 31 days (ADR 0009 S-S3-R3).",
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "from": { "$ref": "#/$defs/LocalDate" },
        "to": { "$ref": "#/$defs/LocalDate" },
        "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 480 },
        "bufferMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "Free time required after the window on every required resource."
        },
        "slotMinutes": {
          "enum": [5, 10, 15, 20, 30, 60],
          "description": "Start granularity in real minutes from local midnight (default 15)."
        },
        "displayTimeZone": { "$ref": "#/$defs/TimeZone" },
        "appointmentTypeCode": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,40}$",
          "description": "Recorded as a constraint; appointment-type rules are not modelled yet (see coverage)."
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/AvailabilityRequirement" }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "$ref": "#/$defs/Cursor" }
      }
    },
    "AvailabilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startsAt",
        "endsAt",
        "durationMinutes",
        "localStart",
        "localEnd",
        "timeZone",
        "resources"
      ],
      "properties": {
        "startsAt": { "$ref": "#/$defs/Instant" },
        "endsAt": { "$ref": "#/$defs/Instant" },
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "localStart": {
          "type": "string",
          "maxLength": 40,
          "description": "Display-zone wall time with offset."
        },
        "localEnd": { "type": "string", "maxLength": 40 },
        "timeZone": { "$ref": "#/$defs/TimeZone" },
        "resources": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/ResourceRef" } }
      }
    },
    "AvailabilitySearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "advisory", "windows", "nextCursor", "constraints", "coverage"],
          "properties": {
            "outcome": {
              "enum": ["windows", "none_free", "no_availability_configured", "no_eligible_resource"]
            },
            "advisory": {
              "const": true,
              "description": "A result is advisory; booking (S10) rechecks against the database constraint."
            },
            "windows": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/AvailabilityWindow" }
            },
            "nextCursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "applied",
                "durationMinutes",
                "bufferMinutes",
                "slotMinutes",
                "locationTimeZone",
                "displayTimeZone",
                "policyRef"
              ],
              "properties": {
                "applied": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]{1,40}$" } },
                "durationMinutes": { "type": "integer" },
                "bufferMinutes": { "type": "integer" },
                "slotMinutes": { "type": "integer" },
                "locationTimeZone": { "$ref": "#/$defs/TimeZone" },
                "displayTimeZone": { "$ref": "#/$defs/TimeZone" },
                "appointmentTypeCode": { "type": "string", "pattern": "^[a-z0-9_-]{1,40}$" },
                "policyRef": { "type": "string", "pattern": "^[a-z0-9./-]{1,64}$" }
              }
            },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["notConsidered", "excludedResources", "statement"],
              "properties": {
                "notConsidered": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-z_]{1,40}$" }
                },
                "excludedResources": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["resourceRef", "reason"],
                    "properties": {
                      "resourceRef": { "$ref": "#/$defs/ResourceRef" },
                      "reason": { "enum": ["inactive", "no_availability_configured"] }
                    }
                  }
                },
                "statement": { "type": "string", "maxLength": 300 }
              }
            }
          }
        }
      }
    },
    "LocationRef": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "Version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "IdempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "ResourceRefId": {
      "type": "string",
      "description": "Opaque server-issued resource identifier. Never parse it.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "EntityRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ResourceKind": { "enum": ["provider", "operatory", "equipment", "staff"] },
    "ResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceRef"],
      "properties": {
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" }
      }
    },
    "OperatoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resourceRef"],
      "properties": {
        "kind": { "const": "operatory" },
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" }
      }
    },
    "DisplayLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
    "DisplayOrder": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "TimeZone": {
      "type": "string",
      "description": "IANA time zone name. The server also requires its zone database to know it.",
      "maxLength": 64,
      "pattern": "^(UTC|[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){1,2})$"
    },
    "LocalDate": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "LocalTime": { "type": "string", "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$" },
    "Instant": {
      "type": "string",
      "description": "RFC 3339 instant with an explicit offset; stored and returned in UTC.",
      "format": "date-time",
      "maxLength": 40
    },
    "ResourceStatus": { "enum": ["active", "inactive"] },
    "TimeBlockReason": {
      "description": "Proposed reason vocabulary for unavailable time (not a practice decision).",
      "enum": ["meeting", "maintenance", "training", "holiday", "lunch", "personal", "other"]
    },
    "NoOperatoryReason": {
      "description": "Reserved exception vocabulary for an appointment that holds no operatory (S7). Proposed; starts with the observed no-show and cancellation cases. Never modelled as a resource.",
      "enum": ["no_show", "cancelled", "not_yet_assigned", "off_site"]
    },
    "AppointmentOperatoryAssignment": {
      "description": "Booking-side shape (consumed by S10): an appointment holds zero or one operatory; holding none requires a typed reason.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatory"],
          "properties": { "operatory": { "$ref": "#/$defs/OperatoryRef" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatory", "noOperatoryReason"],
          "properties": {
            "operatory": { "type": "null" },
            "noOperatoryReason": { "$ref": "#/$defs/NoOperatoryReason" }
          }
        }
      ]
    },
    "WeeklyInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday", "start", "end"],
      "properties": {
        "weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO weekday, 1 = Monday"
        },
        "start": { "$ref": "#/$defs/LocalTime" },
        "end": { "$ref": "#/$defs/LocalTime" }
      }
    },
    "WeeklyHours": { "type": "array", "maxItems": 28, "items": { "$ref": "#/$defs/WeeklyInterval" } },
    "LocationDefine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "displayLabel", "timeZone"],
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "$ref": "#/$defs/DisplayLabel" },
        "timeZone": { "$ref": "#/$defs/TimeZone" }
      }
    },
    "LocationTimeZoneChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeZone", "expectedVersion"],
      "properties": {
        "timeZone": { "$ref": "#/$defs/TimeZone" },
        "expectedVersion": { "$ref": "#/$defs/Version" }
      }
    },
    "ResourceDefine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locationRef"],
      "properties": {
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "$ref": "#/$defs/DisplayLabel" },
        "displayOrder": { "$ref": "#/$defs/DisplayOrder" }
      }
    },
    "AvailabilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveFrom", "weekly"],
      "properties": {
        "effectiveFrom": { "$ref": "#/$defs/LocalDate" },
        "weekly": { "$ref": "#/$defs/WeeklyHours" }
      }
    },
    "ResourceDeactivate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion"],
      "properties": { "expectedVersion": { "$ref": "#/$defs/Version" } }
    },
    "TimeBlockCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "startsAt", "endsAt", "reasonCode", "resources"],
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "startsAt": { "$ref": "#/$defs/Instant" },
        "endsAt": { "$ref": "#/$defs/Instant" },
        "reasonCode": { "$ref": "#/$defs/TimeBlockReason" },
        "resources": {
          "type": "array",
          "maxItems": 20,
          "description": "Empty = a location-wide block.",
          "items": { "$ref": "#/$defs/ResourceRef" }
        }
      }
    },
    "ResourceListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "limit": { "type": "string", "pattern": "^([1-9]|[1-9][0-9]|100)$" },
        "cursor": { "$ref": "#/$defs/Cursor" }
      }
    },
    "LocationListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "string", "pattern": "^([1-9]|[1-9][0-9]|100)$" },
        "cursor": { "$ref": "#/$defs/Cursor" }
      }
    },
    "Cursor": {
      "type": "string",
      "description": "Opaque, tenant-bound, HMAC-protected. Never parse it.",
      "pattern": "^[A-Za-z0-9_-]{1,600}\\.[A-Za-z0-9_-]{22}$"
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "displayLabel", "timeZone", "status", "version"],
      "properties": {
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "$ref": "#/$defs/DisplayLabel" },
        "timeZone": { "$ref": "#/$defs/TimeZone" },
        "status": { "$ref": "#/$defs/ResourceStatus" },
        "version": { "$ref": "#/$defs/Version" }
      }
    },
    "LocationList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor"],
      "properties": {
        "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Location" } },
        "nextCursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] }
      }
    },
    "AvailabilityVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availabilityRef", "effectiveFrom", "effectiveUntil", "timeZone", "weekly"],
      "properties": {
        "availabilityRef": { "$ref": "#/$defs/EntityRef" },
        "effectiveFrom": { "$ref": "#/$defs/LocalDate" },
        "effectiveUntil": {
          "description": "Exclusive; the next version's effectiveFrom, or null when open-ended.",
          "anyOf": [{ "$ref": "#/$defs/LocalDate" }, { "type": "null" }]
        },
        "timeZone": { "$ref": "#/$defs/TimeZone" },
        "weekly": { "$ref": "#/$defs/WeeklyHours" }
      }
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "kind", "locationRef", "displayLabel", "displayOrder", "status", "version"],
      "properties": {
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "anyOf": [{ "$ref": "#/$defs/DisplayLabel" }, { "type": "null" }] },
        "displayOrder": { "$ref": "#/$defs/DisplayOrder" },
        "status": { "$ref": "#/$defs/ResourceStatus" },
        "version": { "$ref": "#/$defs/Version" }
      }
    },
    "ResourceDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRef",
        "kind",
        "locationRef",
        "displayLabel",
        "displayOrder",
        "status",
        "version",
        "availability"
      ],
      "properties": {
        "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "locationRef": { "$ref": "#/$defs/LocationRef" },
        "displayLabel": { "anyOf": [{ "$ref": "#/$defs/DisplayLabel" }, { "type": "null" }] },
        "displayOrder": { "$ref": "#/$defs/DisplayOrder" },
        "status": { "$ref": "#/$defs/ResourceStatus" },
        "version": { "$ref": "#/$defs/Version" },
        "availability": { "type": "array", "items": { "$ref": "#/$defs/AvailabilityVersion" } }
      }
    },
    "ResourceRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": { "data": { "$ref": "#/$defs/ResourceDetail" } }
    },
    "ResourceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor"],
      "properties": {
        "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Resource" } },
        "nextCursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] }
      }
    },
    "StateLabelReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vocabularyVersion",
            "checkedAt",
            "resourcesChecked",
            "stateLabelledCount",
            "stateLabelled"
          ],
          "properties": {
            "vocabularyVersion": { "type": "string", "pattern": "^scheduling-state-labels\\.[0-9]+$" },
            "checkedAt": { "$ref": "#/$defs/Instant" },
            "resourcesChecked": { "type": "integer", "minimum": 0 },
            "stateLabelledCount": { "type": "integer", "minimum": 0 },
            "stateLabelled": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["resourceRef", "kind", "locationRef", "matchedTerm"],
                "properties": {
                  "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
                  "kind": { "$ref": "#/$defs/ResourceKind" },
                  "locationRef": { "$ref": "#/$defs/LocationRef" },
                  "matchedTerm": { "type": "string", "pattern": "^[a-z ]{1,40}$" }
                }
              }
            }
          }
        }
      }
    },
    "LocationCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locationRef", "timeZone"],
          "properties": {
            "locationRef": { "$ref": "#/$defs/LocationRef" },
            "timeZone": { "$ref": "#/$defs/TimeZone" }
          }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "ResourceCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceRef", "kind", "status"],
          "properties": {
            "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
            "kind": { "$ref": "#/$defs/ResourceKind" },
            "status": { "$ref": "#/$defs/ResourceStatus" }
          }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "AvailabilityCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceRef", "availabilityRef", "effectiveFrom"],
          "properties": {
            "resourceRef": { "$ref": "#/$defs/ResourceRefId" },
            "availabilityRef": { "$ref": "#/$defs/EntityRef" },
            "effectiveFrom": { "$ref": "#/$defs/LocalDate" }
          }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "TimeBlockCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeBlockRef"],
          "properties": { "timeBlockRef": { "$ref": "#/$defs/EntityRef" } }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "PatientRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque patient reference (same pattern as patient.schema.json PatientRef)."
    },
    "RequestRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque appointment request reference."
    },
    "AppointmentRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Opaque appointment (booking) reference."
    },
    "ReasonCode": {
      "type": "string",
      "pattern": "^[a-z_]{1,64}$",
      "description": "Server-checked reason enumeration value; never free text."
    },
    "AppointmentTypeCode": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    },
    "PolicyRef": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "RequestState": {
      "enum": ["open", "in_review", "scheduled", "declined", "expired", "withdrawn"]
    },
    "RequestOrigin": {
      "description": "Server-set surface the request came through; never caller input.",
      "enum": ["staff", "portal"]
    },
    "RequestSourceChannel": {
      "enum": ["phone", "walk_in", "email", "portal", "referral", "recall", "other"]
    },
    "RequestFlexibility": {
      "enum": ["any_time", "mornings", "afternoons", "evenings", "weekdays", "weekends"]
    },
    "ContactConsent": {
      "description": "Contact-consent state as recorded on the request; the consent decision itself belongs to E.",
      "enum": ["unknown", "granted", "declined"]
    },
    "RequestNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "PreferredWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": {
          "$ref": "#/$defs/Instant"
        },
        "endsAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "PreferredWindows": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/PreferredWindow"
      }
    },
    "AppointmentRequestCreate": {
      "type": "object",
      "additionalProperties": false,
      "description": "S8 request. Holds no resource and blocks no slot. Needs preferredWindows or flexibility (422 preferenceRequired).",
      "required": ["patientRef", "locationRef", "sourceChannel", "contactConsent"],
      "properties": {
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        },
        "sourceChannel": {
          "$ref": "#/$defs/RequestSourceChannel"
        },
        "appointmentTypeCode": {
          "$ref": "#/$defs/AppointmentTypeCode"
        },
        "providerPreference": {
          "$ref": "#/$defs/ResourceRefId"
        },
        "preferredWindows": {
          "$ref": "#/$defs/PreferredWindows"
        },
        "flexibility": {
          "$ref": "#/$defs/RequestFlexibility"
        },
        "urgent": {
          "type": "boolean"
        },
        "contactConsent": {
          "$ref": "#/$defs/ContactConsent"
        },
        "note": {
          "$ref": "#/$defs/RequestNote"
        }
      }
    },
    "AppointmentRequestPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion"],
      "properties": {
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "providerPreference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRefId"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferredWindows": {
          "$ref": "#/$defs/PreferredWindows"
        },
        "flexibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestFlexibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "urgent": {
          "type": "boolean"
        },
        "contactConsent": {
          "$ref": "#/$defs/ContactConsent"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestNote"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AppointmentRequestReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion"],
      "properties": {
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "AppointmentRequestClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "state", "reasonCode"],
      "description": "Close with a reason. `scheduled` requires appointmentRef (422 otherwise) and links both records; `expired` requires the configured expiryPolicyRef.",
      "properties": {
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "state": {
          "enum": ["scheduled", "declined", "expired", "withdrawn"]
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCode"
        },
        "appointmentRef": {
          "$ref": "#/$defs/AppointmentRef"
        },
        "expiryPolicyRef": {
          "$ref": "#/$defs/PolicyRef"
        }
      }
    },
    "AppointmentRequestReopen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "reasonCode"],
      "properties": {
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCode"
        }
      }
    },
    "AppointmentRequestListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/RequestState"
        },
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        },
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|100)$"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        }
      }
    },
    "RequestTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reasonCode", "appointmentRef", "occurredAt", "version"],
      "properties": {
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestState"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "$ref": "#/$defs/RequestState"
        },
        "reasonCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "appointmentRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppointmentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurredAt": {
          "$ref": "#/$defs/Instant"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "AppointmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestRef",
        "patientRef",
        "locationRef",
        "origin",
        "sourceChannel",
        "appointmentTypeCode",
        "providerPreference",
        "preferredWindows",
        "flexibility",
        "urgent",
        "contactConsent",
        "note",
        "state",
        "stateReason",
        "appointmentRef",
        "version",
        "createdAt",
        "closedAt",
        "transitions"
      ],
      "properties": {
        "requestRef": {
          "$ref": "#/$defs/RequestRef"
        },
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        },
        "origin": {
          "$ref": "#/$defs/RequestOrigin"
        },
        "sourceChannel": {
          "$ref": "#/$defs/RequestSourceChannel"
        },
        "appointmentTypeCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppointmentTypeCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerPreference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRefId"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferredWindows": {
          "$ref": "#/$defs/PreferredWindows"
        },
        "flexibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestFlexibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "urgent": {
          "type": "boolean"
        },
        "contactConsent": {
          "$ref": "#/$defs/ContactConsent"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestNote"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/RequestState"
        },
        "stateReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "appointmentRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppointmentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "createdAt": {
          "$ref": "#/$defs/Instant"
        },
        "closedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "transitions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/RequestTransition"
          }
        }
      }
    },
    "AppointmentRequestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestRef",
        "patientRef",
        "locationRef",
        "state",
        "urgent",
        "appointmentRef",
        "version",
        "createdAt"
      ],
      "properties": {
        "requestRef": {
          "$ref": "#/$defs/RequestRef"
        },
        "patientRef": {
          "$ref": "#/$defs/PatientRef"
        },
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        },
        "state": {
          "$ref": "#/$defs/RequestState"
        },
        "urgent": {
          "type": "boolean"
        },
        "appointmentRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppointmentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "createdAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "AppointmentRequestRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/AppointmentRequest"
        }
      }
    },
    "AppointmentRequestList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor"],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/AppointmentRequestSummary"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AppointmentRequestCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestRef", "state"],
          "properties": {
            "requestRef": {
              "$ref": "#/$defs/RequestRef"
            },
            "state": {
              "$ref": "#/$defs/RequestState"
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "UnbookedRequestReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkedAt", "count", "requests"],
          "description": "Requests that reached a terminal state without a booking (at most 100 listed; count is the total).",
          "properties": {
            "checkedAt": {
              "$ref": "#/$defs/Instant"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "requests": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["requestRef", "locationRef", "state", "reasonCode", "closedAt"],
                "properties": {
                  "requestRef": {
                    "$ref": "#/$defs/RequestRef"
                  },
                  "locationRef": {
                    "$ref": "#/$defs/LocationRef"
                  },
                  "state": {
                    "enum": ["declined", "expired", "withdrawn"]
                  },
                  "reasonCode": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ReasonCode"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "closedAt": {
                    "$ref": "#/$defs/Instant"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
