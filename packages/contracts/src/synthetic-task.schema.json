{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuspatlas.invalid/schemas/synthetic-task/v1",
  "title": "Synthetic task contract v1 (non-clinical foundation fixture domain)",
  "$defs": {
    "TaskRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "LocationRef": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "Label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "Version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "IdempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "Cursor": {
      "type": "string",
      "description": "Opaque, tenant-bound, HMAC-protected. Never parse it.",
      "pattern": "^[A-Za-z0-9_-]{1,200}\\.[A-Za-z0-9_-]{22}$"
    },
    "SyntheticTaskCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/Label" },
        "locationRef": { "$ref": "#/$defs/LocationRef" }
      }
    },
    "SyntheticTaskRelabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "expectedVersion"],
      "properties": {
        "label": { "$ref": "#/$defs/Label" },
        "expectedVersion": { "$ref": "#/$defs/Version" }
      }
    },
    "SyntheticTaskListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "string", "pattern": "^([1-9]|[1-9][0-9]|100)$" },
        "cursor": { "$ref": "#/$defs/Cursor" }
      }
    },
    "SyntheticTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskRef", "label", "locationRef", "version"],
      "properties": {
        "taskRef": { "$ref": "#/$defs/TaskRef" },
        "label": { "$ref": "#/$defs/Label" },
        "locationRef": { "anyOf": [{ "$ref": "#/$defs/LocationRef" }, { "type": "null" }] },
        "version": { "$ref": "#/$defs/Version" }
      }
    },
    "SyntheticTaskRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": { "data": { "$ref": "#/$defs/SyntheticTask" } }
    },
    "SyntheticTaskList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor"],
      "properties": {
        "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/SyntheticTask" } },
        "nextCursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] }
      }
    },
    "SyntheticTaskCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskRef", "label"],
          "properties": { "taskRef": { "$ref": "#/$defs/TaskRef" }, "label": { "$ref": "#/$defs/Label" } }
        },
        "version": { "$ref": "#/$defs/Version" },
        "correlationId": { "type": "string", "format": "uuid" },
        "replayed": { "type": "boolean" }
      }
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "correlationId"],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "validation_failed",
            "unauthenticated",
            "forbidden",
            "not_found",
            "stale_version",
            "idempotency_conflict",
            "conflict",
            "rate_limited",
            "internal_error",
            "service_unavailable",
            "self_approval_denied",
            "payload_mismatch",
            "proposal_expired",
            "policy_changed",
            "approval_invalid"
          ]
        },
        "retryable": { "type": "boolean" },
        "correlationId": { "type": "string", "format": "uuid" },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currentVersion": { "$ref": "#/$defs/Version" },
            "reason": { "type": "string", "pattern": "^[a-z_]{1,64}$" },
            "deficits": {
              "type": "object",
              "additionalProperties": false,
              "description": "C10 addition: what blocks signing under an enforced template (server-derived section keys and synthetic codes).",
              "required": ["missingSections", "missingCodeRefs", "unresolvedSections"],
              "properties": {
                "missingSections": {
                  "type": "array",
                  "maxItems": 30,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
                },
                "missingCodeRefs": {
                  "type": "array",
                  "maxItems": 50,
                  "items": { "type": "string", "pattern": "^SYN-[A-Z0-9-]{1,40}$" }
                },
                "unresolvedSections": {
                  "type": "array",
                  "maxItems": 30,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
                }
              }
            },
            "alternative": {
              "type": "string",
              "description": "C5 addition: operation id of the supported alternative path (server-authored).",
              "pattern": "^[a-z][A-Za-z]{0,40}(\\.[a-z][A-Za-z]{0,40}){0,3}$"
            },
            "blockingRefs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref"],
                "properties": {
                  "kind": { "type": "string", "pattern": "^[a-z][A-Za-z]{0,63}$" },
                  "ref": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              }
            },
            "violations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pointer", "rule"],
                "properties": {
                  "pointer": { "type": "string", "maxLength": 256 },
                  "rule": { "type": "string", "pattern": "^[a-zA-Z]{1,32}$" }
                }
              }
            },
            "conflicts": {
              "type": "array",
              "maxItems": 50,
              "description": "S7/S10 Conflict list (docs/superpowers/plans/2026-11-04-scheduling-and-patients.md, Shared interfaces). Server-authored references only, filtered to the caller's visibility.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "explanation", "overrideable"],
                "properties": {
                  "kind": {
                    "enum": [
                      "resource_overlap",
                      "provider_assignment",
                      "outside_availability",
                      "insufficient_duration",
                      "patient_unavailable",
                      "patient_inactive",
                      "policy_override_required"
                    ]
                  },
                  "resourceRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "resourceRef"],
                    "properties": {
                      "kind": { "enum": ["provider", "operatory", "equipment", "staff"] },
                      "resourceRef": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      }
                    }
                  },
                  "existingRef": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "explanation": { "type": "string", "maxLength": 200 },
                  "overrideable": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  }
}
