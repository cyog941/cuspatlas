{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuspatlas.invalid/schemas/synthetic-task/v1",
  "title": "Synthetic task contract v1 (non-clinical foundation fixture domain)",
  "$defs": {
    "TaskRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "LocationRef": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "Label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "Cursor": {
      "type": "string",
      "description": "Opaque, tenant-bound, HMAC-protected. Never parse it.",
      "pattern": "^[A-Za-z0-9_-]{1,200}\\.[A-Za-z0-9_-]{22}$"
    },
    "SyntheticTaskCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "$ref": "#/$defs/Label"
        },
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        }
      }
    },
    "SyntheticTaskRelabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "expectedVersion"],
      "properties": {
        "label": {
          "$ref": "#/$defs/Label"
        },
        "expectedVersion": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "SyntheticTaskListQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-9][0-9]|100)$"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        }
      }
    },
    "SyntheticTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskRef", "label", "locationRef", "version"],
      "properties": {
        "taskRef": {
          "$ref": "#/$defs/TaskRef"
        },
        "label": {
          "$ref": "#/$defs/Label"
        },
        "locationRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocationRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "SyntheticTaskRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/SyntheticTask"
        }
      }
    },
    "SyntheticTaskList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "nextCursor", "envelope"],
      "properties": {
        "envelope": {
          "$ref": "#/$defs/ListEnvelope"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/SyntheticTask"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SyntheticTaskCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "version", "correlationId", "replayed"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskRef", "label"],
          "properties": {
            "taskRef": {
              "$ref": "#/$defs/TaskRef"
            },
            "label": {
              "$ref": "#/$defs/Label"
            }
          }
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "correlationId"],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "validation_failed",
            "unauthenticated",
            "forbidden",
            "not_found",
            "stale_version",
            "idempotency_conflict",
            "conflict",
            "rate_limited",
            "internal_error",
            "service_unavailable",
            "self_approval_denied",
            "payload_mismatch",
            "proposal_expired",
            "policy_changed",
            "approval_invalid"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currentVersion": {
              "$ref": "#/$defs/Version"
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z_]{1,64}$"
            },
            "deficits": {
              "type": "object",
              "additionalProperties": false,
              "description": "C10 addition: what blocks signing under an enforced template (server-derived section keys and synthetic codes).",
              "required": ["missingSections", "missingCodeRefs", "unresolvedSections"],
              "properties": {
                "missingSections": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "missingCodeRefs": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "pattern": "^SYN-[A-Z0-9-]{1,40}$"
                  }
                },
                "unresolvedSections": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                }
              }
            },
            "alternative": {
              "type": "string",
              "description": "C5 addition: operation id of the supported alternative path (server-authored).",
              "pattern": "^[a-z][A-Za-z]{0,40}(\\.[a-z][A-Za-z]{0,40}){0,3}$"
            },
            "blockingRefs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z]{0,63}$"
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              }
            },
            "violations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pointer", "rule"],
                "properties": {
                  "pointer": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "rule": {
                    "type": "string",
                    "pattern": "^[a-zA-Z]{1,32}$"
                  }
                }
              }
            },
            "conflicts": {
              "type": "array",
              "maxItems": 50,
              "description": "S7/S10 Conflict list (docs/superpowers/plans/2026-11-04-scheduling-and-patients.md, Shared interfaces). Server-authored references only, filtered to the caller's visibility.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "explanation", "overrideable"],
                "properties": {
                  "kind": {
                    "enum": [
                      "resource_overlap",
                      "provider_assignment",
                      "outside_availability",
                      "insufficient_duration",
                      "patient_unavailable",
                      "patient_inactive",
                      "policy_override_required"
                    ]
                  },
                  "resourceRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "resourceRef"],
                    "properties": {
                      "kind": {
                        "enum": ["provider", "operatory", "equipment", "staff"]
                      },
                      "resourceRef": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      }
                    }
                  },
                  "existingRef": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "explanation": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "overrideable": {
                    "type": "boolean"
                  }
                }
              }
            },
            "limit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "description": "S13 addition: the published configuration limit a request exceeded (for example the series occurrence limit).",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z.]{0,63}$"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "earliestAllowedAt": {
              "type": "string",
              "format": "date-time",
              "description": "I8 addition: the computed earliest instant an imaging deletion would be allowed (minimum retention)."
            },
            "occurrences": {
              "type": "array",
              "maxItems": 52,
              "description": "S13 addition: per-occurrence conflicts of a refused series (occurrences without a conflict are omitted).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "startsAt", "conflicts"],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "conflicts": {
                    "$ref": "#/$defs/Refusal/properties/detail/properties/conflicts"
                  }
                }
              }
            }
          }
        }
      }
    },
    "VocabularyName": {
      "type": "string",
      "pattern": "^[a-z][a-z_]{1,63}$",
      "description": "OR-02 vocabulary name (one per registered state set)."
    },
    "VocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "shortCode", "label", "category", "terminal"],
      "description": "One state code with its operator-facing plain label. Category is semantic only (no colour or layout).",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z_]{1,64}$"
        },
        "shortCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,6}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "enum": ["lifecycle", "presence", "exception", "financial", "clinical"]
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "Vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "module", "owner", "version", "entries"],
      "properties": {
        "name": {
          "$ref": "#/$defs/VocabularyName"
        },
        "module": {
          "type": "string",
          "pattern": "^[a-z]{1,32}$"
        },
        "owner": {
          "enum": ["F", "A", "S", "C", "B", "E", "I", "M"]
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z]{1,32}-state-labels\\.[0-9]+$",
          "description": "The owning module registry version; responses carrying a code state it."
        },
        "entries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/VocabularyEntry"
          }
        }
      }
    },
    "VocabularyList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "envelope"],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/Vocabulary"
          }
        },
        "envelope": {
          "$ref": "#/$defs/ListEnvelope"
        }
      }
    },
    "VocabularyRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/Vocabulary"
        }
      }
    },
    "VocabularyPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/VocabularyName"
        }
      }
    },
    "ListScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "OR-01 scope: tenant-wide, the caller's assigned locations, or an explicit location set (locationRefs present for the last two).",
      "properties": {
        "kind": {
          "enum": ["tenant_wide", "assigned_locations", "location_set"]
        },
        "locationRefs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          }
        }
      }
    },
    "ListOrdering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "direction", "tieBreak"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z.]{1,64}$"
        },
        "direction": {
          "enum": ["asc", "desc"]
        },
        "tieBreak": {
          "type": "string",
          "pattern": "^[A-Za-z.]{1,64}$"
        }
      }
    },
    "ListCount": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact"],
          "properties": {
            "exact": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["atLeast"],
          "properties": {
            "atLeast": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "ListEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "description": "OR-01 list envelope, shared by every list and worklist response.",
      "required": [
        "asOf",
        "appliedFilters",
        "scope",
        "limit",
        "truncated",
        "nextCursor",
        "ordering",
        "count"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time",
          "description": "Server instant the list was read."
        },
        "appliedFilters": {
          "type": "object",
          "description": "Normalized filters, including the defaults the server applied."
        },
        "scope": {
          "$ref": "#/$defs/ListScope"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "truncated": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": ["string", "null"]
        },
        "ordering": {
          "$ref": "#/$defs/ListOrdering"
        },
        "count": {
          "$ref": "#/$defs/ListCount"
        }
      }
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "LocalDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ReadComponent": {
      "type": "object",
      "description": "A21 (OR-09) component of a composed read: ok (with freshness and data), restricted (the caller may not see it; requiredAction/requiredScope named, no value) or unavailable (the producer is not deployed; owner named). Neither restricted nor unavailable means none.",
      "required": ["status", "owner"],
      "properties": {
        "status": {
          "enum": ["ok", "restricted", "unavailable"]
        },
        "owner": {
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/ReadFreshness"
        },
        "requiredAction": {
          "type": "string"
        },
        "requiredScope": {
          "type": "string"
        },
        "reason": {
          "enum": ["producer_not_deployed", "producer_failed"]
        },
        "data": {}
      }
    },
    "ReadFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOf", "state", "basis"],
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": ["current", "stale"]
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "ScheduleViewQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationRef", "from"],
      "properties": {
        "locationRef": {
          "$ref": "#/$defs/LocationRef"
        },
        "from": {
          "$ref": "#/$defs/LocalDate"
        },
        "to": {
          "$ref": "#/$defs/LocalDate"
        },
        "grain": {
          "enum": ["detailed", "compact"]
        }
      }
    },
    "ScheduleView": {
      "type": "object",
      "required": [
        "location",
        "from",
        "to",
        "grain",
        "asOf",
        "appointments",
        "appointmentsTruncated",
        "blocks",
        "unavailableIntervals",
        "counters",
        "freshness"
      ],
      "properties": {
        "location": {
          "type": "object"
        },
        "from": {
          "$ref": "#/$defs/LocalDate"
        },
        "to": {
          "$ref": "#/$defs/LocalDate"
        },
        "grain": {
          "enum": ["detailed", "compact"]
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "appointments": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object"
          }
        },
        "appointmentsTruncated": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["blockRef", "startsAt", "endsAt", "reasonCode", "resourceRefs", "locationWide"]
          }
        },
        "unavailableIntervals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resourceRef", "startsAt", "endsAt", "reason"],
            "properties": {
              "reason": {
                "enum": ["closed", "blocked", "outside_availability"]
              }
            }
          }
        },
        "counters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "value", "scope"]
          }
        },
        "freshness": {
          "$ref": "#/$defs/ReadFreshness"
        }
      }
    },
    "ScheduleViewResult": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/ScheduleView"
        }
      }
    },
    "AppointmentDetail": {
      "type": "object",
      "required": [
        "appointmentRef",
        "status",
        "patientRef",
        "startsAt",
        "endsAt",
        "attendance",
        "patient",
        "coverage",
        "balance",
        "plannedProcedures",
        "chart",
        "freshness"
      ],
      "properties": {
        "patient": {
          "$ref": "#/$defs/ReadComponent"
        },
        "coverage": {
          "$ref": "#/$defs/ReadComponent"
        },
        "balance": {
          "$ref": "#/$defs/ReadComponent"
        },
        "plannedProcedures": {
          "$ref": "#/$defs/ReadComponent"
        },
        "freshness": {
          "$ref": "#/$defs/ReadFreshness"
        }
      }
    },
    "AppointmentDetailResult": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "$ref": "#/$defs/AppointmentDetail"
        }
      }
    },
    "NavigationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "kind", "method", "path", "mcpTool"],
      "properties": {
        "operation": {
          "type": "string"
        },
        "kind": {
          "enum": ["query", "command", "capability"]
        },
        "method": {
          "enum": ["get", "post", null]
        },
        "path": {
          "type": ["string", "null"]
        },
        "mcpTool": {
          "type": ["string", "null"]
        }
      }
    },
    "NavigationRead": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "areas"],
          "properties": {
            "version": {
              "type": "string"
            },
            "areas": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["area", "label", "capabilities"],
                "properties": {
                  "area": {
                    "enum": [
                      "scheduling",
                      "clinical",
                      "financial",
                      "communications",
                      "imaging",
                      "administration",
                      "migration"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["key", "label", "entry", "operations"],
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "entry": {
                          "$ref": "#/$defs/NavigationOperation"
                        },
                        "operations": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/NavigationOperation"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "EmptyCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "SavedViewName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z ._-]{0,59}$",
      "description": "Letters, spaces, dots, dashes and underscores only: no digits, so no date, phone or chart number."
    },
    "OperationId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z]{0,40}(\\.[a-z][A-Za-z]{0,40}){0,3}$"
    },
    "SavedViewSave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operation", "filters"],
      "properties": {
        "name": {
          "$ref": "#/$defs/SavedViewName"
        },
        "operation": {
          "$ref": "#/$defs/OperationId"
        },
        "filters": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z]{0,40}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
